# Neon pooled connection. Pooled (not direct) because Vercel functions are short lived
# and each cold start would otherwise open its own direct connection.
DATABASE_URL=""

# Signs the session cookie. Any long random string. Rotating it logs the operator out.
AUTH_SECRET=""

# The single shared password for the app.
APP_PASSWORD=""

# fal.ai key, used server side only for storage upload and the Seedance queue.
FAL_KEY=""

# Anthropic key, used for beat sheet generation and character field rerolls.
ANTHROPIC_API_KEY=""

# The operator's own apparent age. Drives the soft warning when a generated character
# sits more than fifteen years away from it, because the original audio is reused.
OPERATOR_AGE=""


KALODATA_KEY=e598b36e-3c1c-4630-b1cb-b9fa9af152bd
# ElevenLabs, for speech-to-speech voice conversion. Not text-to-speech: the operator's
# take drives the lip motion in the render, so timing has to be preserved exactly.
ELEVENLABS_API_KEY=""
